{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biliardino-noi",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
